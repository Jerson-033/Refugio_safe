@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esAdmin = User.IsInRole("Administrador");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RefugioSafe</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
@if (autenticado)
{
    <header>
        <a class="logo" asp-controller="Home" asp-action="Index">🐾 Refugio Safe</a>
        <nav>
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-controller="Animales" asp-action="Index">Animales</a>
            @if (esAdmin)
            {
                <a asp-controller="Animales" asp-action="Crear">Registrar animal</a>
                <a asp-controller="Adoptantes" asp-action="Index">Adoptantes</a>
                <a asp-controller="Adopciones" asp-action="Index">Solicitudes de adopción</a>
                <a asp-controller="Seguimientos" asp-action="Index">Seguimiento post-adopción</a>
                <a asp-controller="Notificaciones" asp-action="Index">Notificaciones</a>
            }
        </nav>
        <div class="user">
            <span>@User.Identity!.Name (@(esAdmin ? "Administrador" : "Personal del refugio"))</span>
            <form asp-controller="Cuenta" asp-action="Logout" method="post"><button class="rojo">Salir</button></form>
        </div>
    </header>
}
<main>
    @if (TempData["Ok"] is string ok) { <div class="alert ok">@ok</div> }
    @if (TempData["Error"] is string error) { <div class="alert error">@error</div> }
    @RenderBody()
</main>
</body>
</html>
